{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "yuque-search",
  "title": "Yuque Search",
  "description": "Search Yuque documents and open them in the browser",
  "icon": "icon.png",
  "author": "ajie",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Search Yuque",
      "description": "Search private or public Yuque documents",
      "mode": "view"
    }
  ],
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint",
    "fix-lint": "ray lint --fix",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@raycast/api": "^1.104.19",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}
